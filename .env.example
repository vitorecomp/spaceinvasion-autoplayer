# SpaceInvasion Classic / BitMeUp account credentials
# Copy to .env (never commit .env to git!) and fill in your credentials.

SPACEINVASION_EMAIL=
SPACEINVASION_PASSWORD=

# Optional settings
SPACEINVASION_LOCALE=en
SPACEINVASION_STAY_LOGGED_IN=1
SPACEINVASION_UNIVERSE=
SPACEINVASION_2FA_CODE=

# Optional named account profiles (select with: python3 login.py --account ALT)
# SPACEINVASION_ALT_EMAIL=
# SPACEINVASION_ALT_PASSWORD=
# SPACEINVASION_ALT_UNIVERSE=
# SPACEINVASION_ALT_2FA_CODE=

FROM docker.io/library/node:22-slim AS ui-builder

WORKDIR /app/frontend

COPY frontend/package.json ./
RUN npm install --registry=https://registry.npmjs.org --no-audit --no-fund

COPY frontend/index.html frontend/tsconfig.json frontend/vite.config.ts ./
COPY frontend/scripts ./scripts
COPY frontend/src ./src

RUN mkdir -p /app/backend/ui && npm run build

FROM docker.io/library/python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    SPACEINVASION_NO_REEXEC=1 \
    SPACEINVASION_CONTAINER=1 \
    SPACEINVASION_DB_BACKEND=postgres \
    SPACEINVASION_DISK_LOGS=0 \
    SPACEINVASION_UI_DIR=/opt/spaceinvasion-ui

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    chromium-driver \
    curl \
    libpq5 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml /app/pyproject.toml
RUN python3 -c "import pathlib, tomllib; print('\n'.join(tomllib.loads(pathlib.Path('/app/pyproject.toml').read_text())['project']['dependencies']))" > /tmp/deps.txt \
  && pip install --no-cache-dir -r /tmp/deps.txt \
  && rm -f /tmp/deps.txt

COPY --from=ui-builder /app/backend/ui /opt/spaceinvasion-ui
COPY backend/ui/bell.svg backend/ui/favicon.svg backend/ui/favicon.ico /opt/spaceinvasion-ui/
COPY bin /app/bin
COPY backend /app/backend
COPY scripts /app/scripts

EXPOSE 8787
